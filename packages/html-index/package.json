{
  "name": "@cognium/html-index",
  "version": "0.2.0",
  "description": "Static index of built HTML: elements with roles, accessible names, visible labels, inherited language and matching CSS declarations, the IDREF graph, parse errors, stylesheets, media, frames and shadow trees, plus a file index and a cross-page route index. Observations only; ARIA tables are inputs.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage *.tsbuildinfo *.tgz",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "keywords": [
    "html",
    "aria",
    "accessible-name",
    "static-analysis",
    "cognium"
  ],
  "author": {
    "name": "Cognium Labs",
    "url": "https://cognium.dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogniumhq/cognium-dev.git",
    "directory": "packages/html-index"
  },
  "homepage": "https://github.com/cogniumhq/cognium-dev/tree/main/packages/html-index#readme",
  "bugs": {
    "url": "https://github.com/cogniumhq/cognium-dev/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "postcss": "^8.5.29"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
