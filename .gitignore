# Dependencies
node_modules/

# Root uses npm (package-lock.json); bun.lock is only valid inside packages/cli/
/bun.lock

# Build outputs
dist/
coverage/
*.tsbuildinfo

# Standalone binaries (repo-root only — do not ignore plugins/cognium-dev)
/cognium-dev
/cognium-dev-*
*.bun-build

# Package files
*.tgz

# Editor
.vscode/
.idea/
*.swp
*.swo

# Claude Code personal configs (per-user, not project)
# Ignore the directory contents but TRACK .claude/skills/ — the autofix lane's skill and its
# benchmark scorer are project operating procedure, not per-user config, and a fresh clone that
# does not carry them cannot run the lane. settings.local.json (per-user permissions) and
# scheduled_tasks.lock stay ignored. Must be the `.claude/*` form: git cannot re-include a file
# whose parent directory is itself excluded by `.claude/`.
.claude/*
!.claude/skills/

# OS
.DS_Store
Thumbs.db

# Test
*.log
